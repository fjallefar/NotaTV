diff --git a/src/modesetting.c b/src/modesetting.c
index 4d3dc9c..2ed5208 100644
--- a/src/modesetting.c
+++ b/src/modesetting.c
@@ -1875,6 +1875,52 @@ bool drmdev_can_modeset(struct drmdev *drmdev) {
     return can_modeset;
 }
 
+/* NotaTV: lend the display to another process (tvshell's player) and take it back, keeping the same fd (GBM uses it) */
+bool nota_display_off;
+
+void drmdev_nota_release(struct drmdev *drmdev) {
+    ASSERT_NOT_NULL(drmdev);
+    drmdev_lock(drmdev);
+    nota_display_off = true;
+    for (size_t i = 0; i < drmdev->n_crtcs; i++) {
+        kms_req_swap_ptrs(&drmdev->per_crtc_state[i].queued, NULL);
+    }
+    for (size_t i = 0; i < drmdev->n_crtcs; i++) {
+        while (drmdev->per_crtc_state[i].flip_pending) {
+            if (drmdev_on_modesetting_fd_ready_locked(drmdev) != 0) {
+                break;
+            }
+        }
+    }
+    if (drmDropMaster(drmdev->master_fd) != 0) {
+        LOG_ERROR("nota: drmDropMaster: %s\n", strerror(errno));
+    }
+    drmdev_unlock(drmdev);
+}
+
+int drmdev_nota_reacquire(struct drmdev *drmdev) {
+    int ok = 0;
+    ASSERT_NOT_NULL(drmdev);
+    drmdev_lock(drmdev);
+    if (drmSetMaster(drmdev->master_fd) != 0) {
+        ok = errno;
+        LOG_ERROR("nota: drmSetMaster: %s\n", strerror(ok));
+    }
+    /* the other process left its own planes on: learn what is really shown, so the next frame turns them off */
+    for (size_t i = 0; i < drmdev->n_planes; i++) {
+        struct drm_plane *plane = drmdev->planes + i;
+        drmModePlane *kp = drmModeGetPlane(drmdev->fd, plane->id);
+        if (kp != NULL) {
+            plane->committed_state.crtc_id = kp->crtc_id;
+            plane->committed_state.fb_id = kp->fb_id;
+            drmModeFreePlane(kp);
+        }
+    }
+    nota_display_off = false;
+    drmdev_unlock(drmdev);
+    return ok;
+}
+
