+/* NotaTV: lend the display and input to tvshell's player (on = false) and take them back (on = true) */
+static struct window *nota_main_window;
+void flutterpi_nota_display(bool on) {
+    struct flutterpi *fpi = flutterpi;
+    if (fpi == NULL || fpi->drmdev == NULL) {
+        return;
+    }
+    if (!on) {
+        if (fpi->user_input != NULL) {
+            user_input_suspend(fpi->user_input);
+        }
+        drmdev_nota_release(fpi->drmdev);
+        return;
+    }
+    drmdev_nota_reacquire(fpi->drmdev);
+    if (fpi->user_input != NULL) {
+        user_input_resume(fpi->user_input);
+    }
+    if (nota_main_window != NULL) {
+        struct fl_layer_composition *c = window_nota_composition(nota_main_window);
+        if (c != NULL) {
+            window_push_composition(nota_main_window, c);
+            fl_layer_composition_unref(c);
+        }
+    }
+}
