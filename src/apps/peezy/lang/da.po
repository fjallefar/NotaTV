# NotaTV app "peezy" - Danish
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Plex, Jellyfin and Emby - based on Plezy"
msgstr "Plex, Jellyfin og Emby - bygget på Plezy"

msgid "Peezy is incomplete - install it again in the App Store"
msgstr "Peezy er ikke hel - installér den igen i App Store"

msgid "Peezy could not start"
msgstr "Peezy kunne ikke starte"

msgid "Peezy stopped unexpectedly"
msgstr "Peezy stoppede uventet"

msgid "Sign out of Peezy"
msgstr "Log ud af Peezy"

msgid "Deletes all servers, accounts and settings Peezy has saved on this TV"
msgstr "Sletter alle servere, konti og indstillinger, Peezy har gemt på dette tv"

msgid "Peezy starts and is easier to use on a TV"
msgstr "Peezy starter og er lettere at bruge på et tv"

msgid "Fixed: Peezy could not start (the database was not found)"
msgstr "Rettet: Peezy kunne ikke starte (databasen blev ikke fundet)"

msgid "Back on the remote works, also on the error screen"
msgstr "Tilbage på fjernbetjeningen virker, også på fejlskærmen"

msgid "Text and buttons have the right size on 4K TVs"
msgstr "Tekst og knapper har den rigtige størrelse på 4K-tv"

msgid "Plex sign-in: scan the QR code or type the code at plex.tv/link"
msgstr "Plex-login: scan QR-koden eller skriv koden på plex.tv/link"
