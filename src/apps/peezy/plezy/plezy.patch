diff --git a/lib/notatv.dart b/lib/notatv.dart
new file mode 100644
index 0000000..76729f7
--- /dev/null
+++ b/lib/notatv.dart
@@ -0,0 +1,50 @@
+// NotaTV build (Peezy): --dart-define=NOTATV=true. See NotaTV's docs/peezy.md.
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/services.dart';
+
+import 'i18n/strings.g.dart';
+
+/// True in the NotaTV build: a TV, no desktop window, no services the Plezy project runs (trackers' OAuth proxy,
+/// crash reports, Discord, updates), and video played by NotaTV's own player.
+const bool kNotaTV = bool.fromEnvironment('NOTATV');
+
+/// NotaTV's own texts (not in Plezy's translations): English, or Danish when the app runs in Danish.
+String notaText(String en, String da) => LocaleSettings.currentLocale.languageCode == 'da' ? da : en;
+
+/// NotaTV's player was closed by the user (Back): the player screen leaves too.
+final StreamController<void> notaPlayerClosed = StreamController<void>.broadcast();
+
+/// Extra information for NotaTV's player (pause screen, skip intro/credits). Sent before `loadfile`.
+class NotaTVPlayer {
+  static const _channel = MethodChannel('com.plezy/mpv_player');
+
+  static Future<void> meta({String? title, String? subtitle, String? description, String? poster}) async {
+    if (!kNotaTV) return;
+    try {
+      await _channel.invokeMethod('notaMeta', {
+        'json': jsonEncode({
+          'title': ?title,
+          'subtitle': ?subtitle,
+          'description': ?description,
+          'poster': ?poster,
+        }),
+      });
+    } catch (_) {}
+  }
+
+  /// [markers]: (start s, end s, credits?)
+  static Future<void> skip(List<(double, double, bool)> markers) async {
+    if (!kNotaTV) return;
+    try {
+      await _channel.invokeMethod('notaSkip', {
+        'json': jsonEncode({
+          'markers': [
+            for (final m in markers) {'start': m.$1, 'end': m.$2, 'credits': m.$3},
+          ],
+        }),
+      });
+    } catch (_) {}
+  }
+}
