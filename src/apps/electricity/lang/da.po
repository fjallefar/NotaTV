# NotaTV app "electricity" - Danish
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "West Denmark (DK1)"
msgstr "Vestdanmark (DK1)"

msgid "East Denmark (DK2)"
msgstr "Østdanmark (DK2)"

msgid "today"
msgstr "i dag"

msgid "tomorrow"
msgstr "i morgen"

msgid "kr/kWh now"
msgstr "kr/kWh nu"

msgid "Cheapest 3 hours: %s %s-%s (%s kr)"
msgstr "Billigste 3 timer: %s kl. %s-%s (%s kr)"

msgid "Electricity price"
msgstr "Elpris"

msgid "No prices right now"
msgstr "Ingen priser lige nu"

msgid "The prices could not be fetched - check the network."
msgstr "Priserne kunne ikke hentes - tjek netværket."

msgid "Switch area"
msgstr "Skift område"

msgid "Cheapest hour: %s %s-%s  ·  %s kr"
msgstr "Billigste time: %s kl. %s-%s  ·  %s kr"

msgid "Cheapest 3 hours: %s %s-%s  ·  %s kr"
msgstr "Billigste 3 timer: %s kl. %s-%s  ·  %s kr"

msgid "Today: lowest %s  ·  highest %s  ·  average %s kr"
msgstr "I dag: lavest %s  ·  højest %s  ·  gennemsnit %s kr"

msgid "Tomorrow's prices come at about 13:00"
msgstr "Morgendagens priser kommer cirka kl. 13"

msgid "Price area"
msgstr "Prisområde"

msgid "West: Jutland and Funen. East: Zealand, the islands and Bornholm"
msgstr "Vest: Jylland og Fyn. Øst: Sjælland, øerne og Bornholm"

msgid "The electricity price hour by hour, today and tomorrow"
msgstr "Elprisen time for time, i dag og i morgen"

msgid "Electricity price on NotaTV"
msgstr "Elpris på NotaTV"


msgid "Full price with VAT: spot price, grid tariff from %s, Energinet's tariffs, electricity tax and your supplier's surcharge"
msgstr "Samlet pris med moms: spotpris, nettarif fra %s, Energinets tariffer, elafgift og dit elselskabs tillæg"

msgid "Price with VAT: spot price, grid tariff from %s, Energinet's tariffs and electricity tax - your supplier's surcharge can be added in Settings"
msgstr "Pris med moms: spotpris, nettarif fra %s, Energinets tariffer og elafgift - dit elselskabs tillæg kan lægges til under Indstillinger"

msgid "Spot price with VAT - the grid tariff is being fetched"
msgstr "Spotpris med moms - nettariffen hentes"

msgid "Spot price with VAT only - choose your grid company in Settings to see the full price"
msgstr "Kun spotpris med moms - vælg dit netselskab under Indstillinger for at se den samlede pris"

msgid "Grid company"
msgstr "Netselskab"

msgid "The company that owns the cables to your home - it is on your electricity bill. Gives the full price"
msgstr "Selskabet der ejer ledningerne til dit hjem - det står på din elregning. Giver den samlede pris"

msgid "Supplier's surcharge"
msgstr "Elselskabets tillæg"

msgid "What your electricity company adds per kWh, with VAT - it is on your bill or in your contract"
msgstr "Det dit elselskab lægger oven i pr. kWh, med moms - det står på regningen eller i din aftale"

msgid "Not chosen"
msgstr "Ikke valgt"

msgid "None"
msgstr "Intet"



msgid "I don't know - show the spot price"
msgstr "Ved ikke - vis spotprisen"

msgid "Grid company\nThe company that owns the cables to your home - it is on your electricity bill"
msgstr "Netselskab\nSelskabet, der ejer ledningerne til dit hjem - det står på din elregning"

msgid "Supplier's surcharge\nWhat your electricity company adds per kWh, with VAT - on your bill or in your contract"
msgstr "Elselskabets tillæg\nHvad dit elselskab lægger på pr. kWh med moms - står på regningen eller i aftalen"

msgid "Who owns the cables to your home?\nIt is on your electricity bill - it gives the full price. You can change it at the top"
msgstr "Hvem ejer ledningerne til dit hjem?\nDet står på din elregning og giver den samlede pris. Du kan ændre det øverst"

msgid "Grid company: %s"
msgstr "Netselskab: %s"

msgid "Choose grid company"
msgstr "Vælg netselskab"

msgid "Surcharge: %s"
msgstr "Tillæg: %s"

msgid "Price with VAT: spot price, grid tariff from %s, Energinet's tariffs and electricity tax - add your supplier's surcharge at the top"
msgstr "Pris med moms: spotpris, nettarif fra %s, Energinets tariffer og elafgift - tilføj elselskabets tillæg øverst"

msgid "Spot price with VAT only - choose your grid company at the top to see the full price"
msgstr "Kun spotpris med moms - vælg dit netselskab øverst for at se den samlede pris"

msgid "The full price with the grid tariff: choose your grid company at the top of the app - the first time, the app asks"
msgstr "Den samlede pris med nettarif: vælg dit netselskab øverst i appen - første gang spørger appen selv"

msgid "Price area and your electricity company's surcharge are chosen at the top too"
msgstr "Prisområde og dit elselskabs tillæg vælges også øverst"

msgid "Price area\nWest: Jutland and Funen. East: Zealand, the islands and Bornholm"
msgstr "Prisområde\nVest: Jylland og Fyn. Øst: Sjælland, øerne og Bornholm"
