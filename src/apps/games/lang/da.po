# NotaTV app "games" - Danish
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Last used"
msgstr "Sidst brugt"

msgid "Paired with %s"
msgstr "Parret med %s"

msgid "Pairing interrupted"
msgstr "Parring afbrudt"

msgid "Games - pairing"
msgstr "Spil - parring"

msgid "On the PC, open https://localhost:47990 → PIN"
msgstr "Åbn https://localhost:47990 på PC'en → PIN"

msgid "Enter the code on Sunshine's page. Back = cancel"
msgstr "Skriv koden på Sunshines side. Tilbage = annullér"

msgid "Games"
msgstr "Spil"

msgid "PCs with Sunshine on the network"
msgstr "PC'er med Sunshine på netværket"

msgid "No PC found"
msgstr "Ingen PC fundet"

msgid "Searching… Start Sunshine on the PC. Its firewall must allow TCP 47984-48010 and UDP 47998-48000 (UDP 5353 makes it found faster)."
msgstr "Søger… Start Sunshine på PC'en. Dens firewall skal tillade TCP 47984-48010 og UDP 47998-48000 (UDP 5353 gør, at den findes hurtigere)."

msgid "Paired"
msgstr "Parret"

msgid "Not paired - OK to pair"
msgstr "Ikke parret - OK for at parre"

msgid "Unreachable"
msgstr "Kan ikke nås"

msgid "No apps"
msgstr "Ingen apps"

msgid "The PC sent no apps."
msgstr "PC'en sendte ingen apps."

msgid "Running - OK continues"
msgstr "Kører - OK fortsætter"

msgid "The stream stopped with an error (see /tmp/tvmoon.log)"
msgstr "Streamen stoppede med en fejl (se /tmp/tvmoon.log)"

msgid "Quitting the game on the PC…"
msgstr "Afslutter spillet på PC'en …"

msgid "Search for PCs again"
msgstr "Søg efter PC'er igen"

msgid "Quit the running game on the PC"
msgstr "Afslut det kørende spil på PC'en"

msgid "Refresh the list"
msgstr "Opdater listen"

msgid "Automatic (HEVC)"
msgstr "Automatisk (HEVC)"

msgid "H.264 (slow)"
msgstr "H.264 (langsom)"

msgid "Keep the UI's"
msgstr "Behold UI'ets"

msgid "1080p 120 Hz (lowest latency)"
msgstr "1080p 120 Hz (lavest forsinkelse)"

msgid "Resolution"
msgstr "Opløsning"

msgid "The resolution the PC streams in"
msgstr "Opløsningen PC'en sender i"

msgid "Frames per second"
msgstr "Billeder pr. sekund"

msgid "Above 60 requires the display mode to be 120 Hz"
msgstr "Over 60 kræver at skærmtilstanden er 120 Hz"

msgid "Higher = sharper picture, but more data on the network"
msgstr "Højere = skarpere billede, men mere data på netværket"

msgid "HEVC decodes in ~4 ms, H.264 takes ~67 ms on a Pi 4"
msgstr "HEVC dekodes på ~4 ms, H.264 bruger ~67 ms på Pi 4"

msgid "Display mode while gaming"
msgstr "Skærmtilstand under spil"

msgid "120 Hz halves the wait for the next frame. The TV switches mode at start"
msgstr "120 Hz halverer ventetiden på næste billede. TV'et skifter tilstand ved start"

msgid "HEVC 10-bit HDR, if the PC's display is in HDR"
msgstr "HEVC 10-bit HDR, hvis PC'ens skærm står i HDR"

msgid "Play games from your PC via Sunshine (Moonlight)"
msgstr "Spil fra din PC via Sunshine (Moonlight)"

msgid "HEVC (the Pi 5 has no H.264 decoder)"
msgstr "HEVC (Pi 5 har ingen H.264-dekoder)"

msgid "OK = start · While playing: Red on the remote opens the menu, Select + Start + LB + RB on a controller quits"
msgstr "OK = start · Under spillet: Rød på fjernbetjeningen åbner menuen, Select + Start + LB + RB på en controller afslutter"

msgid "Settings"
msgstr "Indstillinger"

msgid "Uninstalling deletes the pairing"
msgstr "Afinstallation sletter parringen"

msgid "Uninstalling Games now deletes the pairing with your PC (certificate and key)"
msgstr "Når Spil afinstalleres, slettes parringen med din pc nu også (certifikat og nøgle)"

msgid "Pair the PC again after installing it again"
msgstr "Par pc'en igen, når du har installeret appen igen"
