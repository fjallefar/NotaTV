# NotaTV app "music" - Danish
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Or connect directly from the TV:"
msgstr "Eller forbind direkte fra TV'et:"

msgid "+  Pair new phone"
msgstr "+  Par ny telefon"

msgid "Phone"
msgstr "Telefon"

msgid "   -   connecting…"
msgstr "   -   forbinder …"

msgid "Music"
msgstr "Musik"

msgid "Play music from your phone on the TV"
msgstr "Spil musik fra din telefon på TV'et"

msgid "Choose \"%s\""
msgstr "Vælg \"%s\""

msgid "Start music"
msgstr "Start musik"

msgid "in any app - Spotify too"
msgstr "i en hvilken som helst app - også Spotify"

msgid "AirPlay or Bluetooth"
msgstr "AirPlay eller Bluetooth"

msgid "the AirPlay icon, or Bluetooth on the phone"
msgstr "AirPlay-ikonet, eller Bluetooth på telefonen"

msgid "the music now plays on the TV"
msgstr "musikken spiller nu på TV'et"

msgid "AirPlay: iPhone, iPad and Mac on the same network  ·  Bluetooth: all phones"
msgstr "AirPlay: iPhone, iPad og Mac på samme netværk  ·  Bluetooth: alle telefoner"

msgid "CONNECTED"
msgstr "FORBUNDET"

msgid "Start music on the phone - or press OK"
msgstr "Start musik på telefonen - eller tryk OK"

msgid "Play"
msgstr "Afspil"

msgid "NOW PLAYING"
msgstr "SPILLER NU"

msgid "PAUSED"
msgstr "PAUSET"

msgid "Unknown track"
msgstr "Ukendt nummer"

msgid " from "
msgstr " fra "

msgid "   ·   ← →: previous/next"
msgstr "   ·   ← →: forrige/næste"

msgid "   ·   Control playback from the phone"
msgstr "   ·   Styr afspilningen fra telefonen"

msgid "Pause/play"
msgstr "Pause/afspil"

msgid "Bluetooth disconnected"
msgstr "Bluetooth afbrudt"

msgid "Disconnect Bluetooth"
msgstr "Afbryd Bluetooth"

msgid "Play music from your phone via AirPlay"
msgstr "Spil musik fra telefonen via AirPlay"


msgid "Protect OLED screens from burn-in"
msgstr "Beskyt OLED-skærme mod indbrænding"

msgid "Everything on the Music screen and in the Now playing box moves very slowly, so nothing stands still for hours. You will not notice it"
msgstr "Alt på Musik-skærmen og i Spiller nu-boksen flytter sig meget langsomt, så intet står stille i timevis. Du lægger ikke mærke til det"

msgid "Cover art at once, and a Now playing box"
msgstr "Cover med det samme og en Spiller nu-boks"

msgid "A cover in the album's colors shows at once and the real cover fades in when it arrives - usually much sooner now"
msgstr "Et cover i albummets farver vises med det samme, og det rigtige cover tones ind, når det kommer - som regel meget hurtigere nu"

msgid "Covers you have seen before are remembered"
msgstr "Covers, du har set før, huskes"

msgid "A small Now playing box in the top corner when you leave Music while something plays (needs NotaTV 1.0.5)"
msgstr "En lille Spiller nu-boks i hjørnet foroven, når du forlader Musik, mens der spilles (kræver NotaTV 1.0.5)"

msgid "Settings: protect OLED screens from burn-in (on by default)"
msgstr "Indstillinger: beskyt OLED-skærme mod indbrænding (slået til som standard)"

msgid "Cover art from"
msgstr "Covers hentes fra"

msgid "Apple, then MusicBrainz"
msgstr "Apple, så MusicBrainz"

msgid "Apple (iTunes) only"
msgstr "Kun Apple (iTunes)"

msgid "MusicBrainz only"
msgstr "Kun MusicBrainz"

msgid "For Bluetooth music. Apple is fastest; MusicBrainz is an open music database. Only the chosen ones get the artist and album"
msgstr "Til Bluetooth-musik. Apple er hurtigst; MusicBrainz er en åben musikdatabase. Kun de valgte får kunstner og album at vide"

msgid "Settings: choose where cover art comes from - Apple, MusicBrainz, or both with either one first"
msgstr "Indstillinger: vælg hvor covers hentes fra - Apple, MusicBrainz eller begge med den ene først"

msgid "MusicBrainz, then Apple"
msgstr "MusicBrainz, så Apple"
