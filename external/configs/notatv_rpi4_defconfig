# NotaTV - Raspberry Pi 4 and Pi 5 (64-bit, one image; Cortex-A72 code also runs on the Pi 5's A76). Built in output-rpi4/ (see Makefile: make)
# --- Architecture and toolchain ---
BR2_aarch64=y
BR2_cortex_a72=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_DL_DIR="$(BR2_EXTERNAL_NOTATV_PATH)/../dl"
BR2_CCACHE=y
BR2_CCACHE_DIR="$(BR2_EXTERNAL_NOTATV_PATH)/../.ccache"
BR2_OPTIMIZE_2=y
BR2_PER_PACKAGE_DIRECTORIES=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches $(BR2_EXTERNAL_NOTATV_PATH)/board/rpi4/patches $(BR2_EXTERNAL_NOTATV_PATH)/board/notatv/patches"
# Raspberry Pi's ffmpeg fork (HEVC hardware decoding)
# (ffmpeg uses V4L2 headers from the Pi kernel 6.12 in board/rpi4/uapi; the toolchain's 5.4 headers are too old)
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_NOTATV_PATH)/board/rpi4/ffmpeg-override.mk"

# --- System ---
BR2_TARGET_GENERIC_HOSTNAME="notatv"
BR2_TARGET_GENERIC_ISSUE="NotaTV"
BR2_TARGET_GENERIC_ROOT_PASSWD="notatv"
BR2_INIT_BUSYBOX=y
# eudev: loads kernel modules and provides libudev for ffmpeg's v4l2-request
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP=""
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Copenhagen"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NOTATV_PATH)/board/notatv/rootfs-overlay $(BR2_EXTERNAL_NOTATV_PATH)/board/rpi4/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_NOTATV_PATH)/board/notatv/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_NOTATV_PATH)/board/rpi4/post-image.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NOTATV_PATH)/board/notatv/busybox.fragment"

# --- Kernel (Raspberry Pi's kernel) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NOTATV_PATH)/board/rpi4/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b broadcom/bcm2711-rpi-400 broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_XZ=y

# --- Firmware ---
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_TOOLS=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_NOTATV_PATH)/board/rpi4/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_NOTATV_PATH)/board/rpi4/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y

# --- Graphics and video (V3D/VC4, hardware decoding via V4L2) ---
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_FFPROBE=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_EXTRACONF="--enable-v4l2-request --enable-libudev --enable-v4l2-m2m --enable-sand --disable-mmal --extra-cflags=-I$(BR2_EXTERNAL_NOTATV_PATH)/board/rpi4/uapi"
BR2_PACKAGE_LUAJIT=y
BR2_PACKAGE_MPV=y
BR2_PACKAGE_SDL3=y
BR2_PACKAGE_SDL3_OPENGLES=y
BR2_PACKAGE_SDL3_KMSDRM=y

# --- Audio ---
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# --- Network ---
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_GNUTLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
# iw: turn off Wi-Fi power saving (libexec/notatv/wifi, dhcp-script)
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_DROPBEAR=y

# --- HDMI-CEC ---
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
BR2_PACKAGE_LINUXCONSOLETOOLS=y
BR2_PACKAGE_LINUXCONSOLETOOLS_INPUTATTACH=y

# --- Diske ---
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y

# --- Diverse ---
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_DEJAVU=y

# --- NotaTV ---
BR2_PACKAGE_TVSHELL=y
BR2_PACKAGE_YT_DLP=y
BR2_PACKAGE_LIBGAMESTREAM=y
BR2_PACKAGE_TVMOON=y
BR2_PACKAGE_OPUS=y

# --- Image: SD card (boot FAT + rootfs ext4 + NOTADATA) ---
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="notatv"
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_EXT2_RESBLKS=0
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
# Casting (phase 1): AirPlay audio - all open source (shairport-sync MIT/BSD, nqptp GPL, avahi LGPL, dbus GPL/AFL)
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
# BR2_PACKAGE_AVAHI_AUTOIPD is not set
BR2_PACKAGE_AVAHI_LIBAVAHI_CLIENT=y
BR2_PACKAGE_SHAIRPORT_SYNC=y
BR2_PACKAGE_SHAIRPORT_SYNC_AIRPLAY2=y
# Casting (phase 2): Bluetooth audio - BlueZ (GPL) + bluez-alsa (MIT); the chip firmware is Broadcom's (accepted by the user)
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ_ALSA=y
# Casting (phase 3): DLNA receiver (libupnp/pupnp, BSD)
BR2_PACKAGE_LIBUPNP=y
# Casting (phase 4): WebSocket for Jellyfin remote control
BR2_PACKAGE_LIBCURL_WEBSOCKETS_SUPPORT=y
BR2_PACKAGE_UXPLAY=y
# oprydning (audit 70/71)
# BR2_PACKAGE_GSTREAMER1_GST_DEBUG is not set
# BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS is not set
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_NETWORK is not set
BR2_PACKAGE_HOST_BMAP_TOOLS=y
# used by libcurl on the box (HTTP/2, asynchronous DNS) and Node
BR2_PACKAGE_C_ARES=y
BR2_PACKAGE_NGHTTP2=y
BR2_PACKAGE_LIBUV=y

# --- deselected (so a fresh build matches .config) ---
# BR2_PACKAGE_AVAHI_AUTOIPD is not set
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_NETWORK is not set
# BR2_PACKAGE_GSTREAMER1_GST_DEBUG is not set
# BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS is not set
# BR2_TARGET_ROOTFS_TAR is not set
