# NotaTV kernel fragment (applied on top of x86_64_defconfig)
# Principle: all hardware we know is built in (no modules, no udev),
# so the kernel can start the UI without waiting for module loading.

# --- Boot: EFI stub without a bootloader, built-in command line ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y
CONFIG_EFIVAR_FS=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="quiet loglevel=3 i915.fastboot=1 snd_intel_dspcfg.dsp_driver=1 vt.global_cursor_default=0 tsc=reliable console=tty1 console=ttyS0,115200"
CONFIG_KERNEL_ZSTD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_MODULES is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_LOGO is not set
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y
# CONFIG_FW_LOADER_USER_HELPER is not set
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_WATCHDOG=y
CONFIG_ITCO_WDT=y
CONFIG_SOFT_WATCHDOG=y

# --- Grafik ---
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_I915_CAPTURE_ERROR=n
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_DRM_DISPLAY_DP_AUX_CEC=y
CONFIG_DRM_DP_CEC=y

# --- HDMI-CEC (TV remote) ---
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=n
CONFIG_MEDIA_CEC_SUPPORT=y
CONFIG_CEC_CORE=y
CONFIG_MEDIA_CEC_RC=y
CONFIG_RC_CORE=y
CONFIG_RC_MAP=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_MCEUSB=y
CONFIG_IR_ITE_CIR=y
CONFIG_IR_NUVOTON=y
CONFIG_USB_PULSE8_CEC=y
CONFIG_USB_RAINSHADOW_CEC=y
CONFIG_SERIO=y
CONFIG_SERIO_SERPORT=y
CONFIG_USB_ACM=y

# --- Input ---
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_NINTENDO=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_VIRTIO_INPUT=y

# --- Audio (HDMI + analog) ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_I915=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_GENERIC=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ALC269=y
CONFIG_SND_HDA_CODEC_ALC662=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_PREALLOC_SIZE=2048
CONFIG_SND_INTEL_DSP_CONFIG=y
CONFIG_SND_USB_AUDIO=y

# --- Lager ---
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_ATA=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_CIFS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_TMPFS=y

# --- USB ---
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y

# --- Network ---
CONFIG_PACKET=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_R8169=y
CONFIG_VIRTIO_NET=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLMLD=y
CONFIG_RTW88=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW89=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852BE=y
CONFIG_RTW89_8852CE=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y

# --- QEMU / virtio ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_HW_RANDOM_VIRTIO=y
