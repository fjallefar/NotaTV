#!/bin/sh
# update: usb  - finds notatv.efi or notatv*.iso on a USB drive and installs it
. /usr/libexec/notatv/lib.sh
[ "$1" = usb ] || exit 1
[ "$(cat $RUN/mode 2>/dev/null)" = installed ] || { echo "Updating requires NotaTV to be installed on disk"; exit 1; }
$H/automount >/dev/null 2>&1
NEW=""
for f in /media/*/notatv.efi /media/*/*/notatv.efi; do [ -f "$f" ] && { NEW=$f; break; }; done
if [ -z "$NEW" ]; then
	for iso in /media/*/notatv*.iso /media/*/*/notatv*.iso; do
		[ -f "$iso" ] || continue
		mkdir -p $RUN/upd
		mount -o loop,ro "$iso" $RUN/upd 2>/dev/null && [ -f $RUN/upd/notatv.efi ] && { NEW=$RUN/upd/notatv.efi; break; }
		umount $RUN/upd 2>/dev/null
	done
fi
[ -n "$NEW" ] || { echo "No notatv.efi or notatv.iso found on USB"; exit 1; }
[ "$(head -c 2 "$NEW")" = MZ ] || { echo "The file is not a valid NotaTV system"; exit 1; }
progress "Installing update…"
esp=$(findfs LABEL=NOTABOOT 2>/dev/null)
[ -n "$esp" ] || { echo "Cannot find the system partition"; exit 1; }
mkdir -p $RUN/esp
mount "$esp" $RUN/esp || { echo "Cannot mount the system partition"; exit 1; }
cp $RUN/esp/EFI/notatv/notatv.efi $RUN/esp/EFI/notatv/notatv-forrige.efi 2>/dev/null
cp "$NEW" $RUN/esp/EFI/notatv/notatv.efi.new && mv $RUN/esp/EFI/notatv/notatv.efi.new $RUN/esp/EFI/notatv/notatv.efi
cp "$NEW" $RUN/esp/EFI/BOOT/BOOTX64.EFI
sync
umount $RUN/esp
umount $RUN/upd 2>/dev/null
log "opdateret fra $NEW"
echo OK
