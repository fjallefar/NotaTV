#!/bin/sh
# udhcpc hook: set address, route and DNS
# udhcpc may be started by tvshell (wifi), which runs with umask 077: resolv.conf must still be readable for
# everyone, or mpv/yt-dlp as the user media cannot look up any host name (1.0.21: nothing played over Wi-Fi)
umask 022
case "$1" in
deconfig) ip addr flush dev $interface; ip link set $interface up ;;
bound|renew)
	# Wi-Fi: power saving off after every (re)connection (see libexec/notatv/wifi)
	[ -d /sys/class/net/$interface/wireless ] && command -v iw >/dev/null && iw dev $interface set power_save off 2>/dev/null
	# the same address as before (a renewal): leave it alone - flushing it cuts open connections (a playing stream)
	if ! ip -4 addr show dev $interface | grep -q "inet $ip/${mask:-24} "; then
		ip addr flush dev $interface
		ip addr add $ip/${mask:-24} ${broadcast:+broadcast $broadcast} dev $interface
	fi
	if [ -n "$router" ]; then
		while ip route del default dev $interface 2>/dev/null; do :; done
		metric=10; [ -d /sys/class/net/$interface/wireless ] && metric=20
		for r in $router; do ip route add default via $r dev $interface metric $metric; break; done
	fi
	# /etc/resolv.conf is a symlink into /run (RAM): write there, so the rootfs is not changed
	R=/run/resolv.conf
	: > $R.tmp
	[ -n "$domain" ] && echo "search $domain" >> $R.tmp
	for d in $dns; do echo "nameserver $d" >> $R.tmp; done
	# if the DNS server does not answer a query, wait 1 s (not 5) before retrying
	echo "options timeout:1 attempts:3" >> $R.tmp
	chmod 644 $R.tmp
	mv $R.tmp $R
	# the firewall lets this network in (it may use public addresses)
	/usr/libexec/notatv/firewall apply >/dev/null 2>&1 &
	[ "$1" = bound ] && echo "[$(date +%T)] net: $interface got $ip (up $(cut -d' ' -f1 /proc/uptime) s)" >> /tmp/notatv.log
	;;
esac
exit 0
