#!/bin/sh
# mount USB drives under /media/<name> and any network drives
. /usr/libexec/notatv/lib.sh
mkdir -p /media
# only one at a time
mkdir $RUN/automount.lock 2>/dev/null || exit 0
trap 'rmdir $RUN/automount.lock' EXIT
# remove mounts for drives that have been unplugged
grep ' /media/' /proc/mounts | while read -r dev mnt rest; do
	case "$dev" in /dev/*) [ -b "$dev" ] || { umount -l "$mnt"; rmdir "$mnt" 2>/dev/null; } ;; esac
done
for d in /dev/sd[a-z][0-9]* /dev/sd[a-z] /dev/mmcblk[0-9]p[0-9]* /dev/nvme[0-9]n[0-9]p[0-9]*; do
	[ -b "$d" ] || continue
	grep -q "^$d " /proc/mounts && continue
	info=$(blkid "$d" 2>/dev/null)
	[ -z "$info" ] && continue
	label=$(echo "$info" | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p')
	type=$(echo "$info" | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')
	case "$label" in NOTABOOT|NOTADATA|NOTATV*) continue ;; esac
	case "$type" in vfat|exfat|ntfs|ext2|ext3|ext4|iso9660|udf|btrfs|xfs) ;; *) continue ;; esac
	# the label comes from the drive: only plain characters, and never "." or ".." (a stick labelled ".." would be
	# mounted on top of /)
	name=$(printf '%s' "${label:-${d##*/}}" | tr -c 'A-Za-z0-9._ -' '_' | cut -c1-40)
	case "$name" in ''|.|..) name=${d##*/} ;; esac
	mnt="/media/$name"
	[ -e "$mnt" ] && mnt="/media/$name-${d##*/}"
	mkdir -p "$mnt"
	opt=ro,nosuid,nodev,noexec # media only: nothing on a drive can run or act as a device
	[ "$type" = ntfs ] && type=ntfs3
	mount -t "$type" -o $opt "$d" "$mnt" 2>/dev/null || rmdir "$mnt"
done
# network drives
share=$(cfg_get media_share "")
mnt=/media/Netværk
if [ -n "$share" ] && ! grep -q " $mnt " /proc/mounts; then
	mkdir -p "$mnt"
	case "$share" in
	smb://*)
		rest=${share#smb://}
		cred=""; case "$rest" in *@*) cred=${rest%%@*}; rest=${rest#*@} ;; esac
		case "$cred" in
		*:*)
			user=${cred%%:*}; pass=${cred#*:}
			;;
		*)
			# no password in the address: the username from the address, otherwise the one saved in Settings
			user=${cred:-$(cfg_get media_share_user "")}
			pass=$(cfg_get media_share_pass "")
			;;
		esac
		host=${rest%%/*}; path=${rest#*/}
		# the login in a file only root can read (not on the command line, and a comma in the password works)
		C=$RUN/cifs.cred
		mkdir -p $RUN && (umask 077; printf 'username=%s\npassword=%s\n' "${user:-guest}" "$pass" > $C)
		mount -t cifs "//$host/$path" "$mnt" -o "ro,nosuid,nodev,noexec,vers=3.0,credentials=$C" 2>/dev/null ||
			mount -t cifs "//$host/$path" "$mnt" -o "ro,nosuid,nodev,noexec,vers=2.0,credentials=$C" 2>/dev/null ||
			{ rmdir "$mnt"; log "netværksdrev fejlede: $host/$path"; }
		rm -f $C
		;;
	nfs://*)
		rest=${share#nfs://}
		host=${rest%%/*}; path=/${rest#*/}
		# BusyBox mount (without FEATURE_MOUNT_NFS) resolves the host itself and adds addr=
		# for the kernel. No own nslookup: for an IP it printed the DNS server ("x.x.x.x:53"),
		# which gave the kernel a bad addr= and the mount always failed.
		# NFSv4 first, then v3 (nolock: there is no rpc.statd on the box).
		mount -t nfs4 -o ro,nosuid,nodev,noexec,soft,timeo=50 "$host:$path" "$mnt" 2>/dev/null ||
			mount -t nfs -o ro,nosuid,nodev,noexec,soft,timeo=50,vers=3,nolock "$host:$path" "$mnt" 2>/dev/null ||
			{ rmdir "$mnt"; log "NFS fejlede: $share"; }
		;;
	esac
fi
exit 0
