#!/bin/sh
# Wi-Fi: boot | start | scan | connect <ssid> <password> | forget
. /usr/libexec/notatv/lib.sh
up_s() { cut -d' ' -f1 /proc/uptime; }
wlan() { for d in /sys/class/net/*; do [ -d $d/wireless ] && { echo ${d##*/}; return; }; done; }
W=$(wlan)
CONFW=/data/notatv/wpa_supplicant.conf

# Wi-Fi power saving off: on the Pi 4's chip (brcmfmac) it makes new connections take seconds and streams stall,
# even with a strong signal. Also set in dhcp-script after every (re)connection, where the driver may turn it on again.
nopower() { command -v iw >/dev/null && iw dev $W set power_save off 2>/dev/null; return 0; }

# the Wi-Fi rules (allowed channels and power) of the country chosen in the setup guide, not always Denmark's
wifi_country() {
	c=$(cfg_get tz_country DK | tr 'a-z' 'A-Z')
	case "$c" in [A-Z][A-Z]) echo "$c" ;; *) echo DK ;; esac
}

ensure() {
	[ -n "$W" ] || { echo "No Wi-Fi adapter found"; exit 1; }
	[ -f $CONFW ] || printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\ncountry=%s\n' "$(wifi_country)" > $CONFW
	c=$(wifi_country)
	grep -q "^country=$c\$" $CONFW || { sed "s/^country=.*/country=$c/" $CONFW > $CONFW.new && mv $CONFW.new $CONFW; }
	wpa_cli -i $W ping >/dev/null 2>&1 && return 0
	# boot (S05) and start (S60) can come at the same time: only one starts wpa_supplicant ($RUN is in RAM)
	mkdir -p $RUN
	i=0; until mkdir $RUN/wifi.lock 2>/dev/null; do i=$((i+1)); [ $i -ge 100 ] && break; sleep 0.1; done
	if ! wpa_cli -i $W ping >/dev/null 2>&1; then
		log "wifi: starting on $W (country $c, up $(up_s) s)"
		ip link set $W up
		# -t -f: wpa_supplicant's own messages with time stamps (scan, connect, why it failed) for the log bundle
		wpa_supplicant -B -t -f /tmp/wpa_supplicant.log -i $W -c $CONFW -D nl80211 >/dev/null 2>&1
		i=0; until wpa_cli -i $W ping >/dev/null 2>&1 || [ $i -ge 30 ]; do sleep 0.1; i=$((i+1)); done
		nopower
		# the moment Wi-Fi is connected, wifi-event asks udhcpc for an address. -A 3: when no address came,
		# try again after 3 s (BusyBox' default is 20 s, which is what made Wi-Fi take up to a minute at boot)
		wpa_cli -i $W -a $H/wifi-event -B >/dev/null 2>&1
		udhcpc -b -A 3 -i $W -x hostname:$(hostname) -s $H/dhcp-script -p /run/udhcpc.$W.pid >/dev/null 2>&1
		# connected before wpa_cli was listening: no CONNECTED event came, so wake udhcpc now
		wpa_cli -i $W status 2>/dev/null | grep -q '^wpa_state=COMPLETED' && kill -USR1 $(cat /run/udhcpc.$W.pid 2>/dev/null) 2>/dev/null
	fi
	rmdir $RUN/wifi.lock 2>/dev/null
	return 0
}

case "$1" in
boot)
	# at the very start of booting (S05notatv, in the background): load the Wi-Fi driver now instead of waiting for
	# udev (S10), and connect as soon as the adapter is there - not first when S60 brings up the network
	[ -f $CONFW ] && grep -q network= $CONFW || exit 0
	[ -n "$W" ] || modprobe brcmfmac 2>/dev/null
	i=0; while [ -z "$W" ] && [ $i -lt 150 ]; do sleep 0.1; i=$((i+1)); W=$(wlan); done
	[ -n "$W" ] || { log "wifi: no adapter after 15 s"; exit 0; }
	log "wifi: adapter $W ready (up $(up_s) s)"
	ensure
	;;
start)
	[ -n "$W" ] && [ -f $CONFW ] && grep -q network= $CONFW && ensure
	;;
scan)
	ensure
	wpa_cli -i $W scan >/dev/null
	sleep 4
	wpa_cli -i $W scan_results | tail -n +2 | awk -F'\t' '
		$5 != "" {
			sig = 2 * ($3 + 100); if (sig > 100) sig = 100; if (sig < 0) sig = 0
			sec = ($4 ~ /WPA|WEP|SAE/) ? "secured" : "open"
			if (!($5 in best) || sig > best[$5]) { best[$5] = sig; s[$5] = sec }
		}
		END { for (n in best) printf "%s\t%d\t%s\n", n, best[n], s[n] }' | sort -t"$(printf '\t')" -k2 -nr
	;;
connect)
	ensure
	ssid=$2; psk=$3
	# the networks that work today stay until the new one has connected: a typo in the password must not leave
	# the box without network. select_network only disables them in memory; nothing is saved before success
	old=$(wpa_cli -i $W list_networks | tail -n +2 | cut -f1)
	id=$(wpa_cli -i $W add_network | tail -1)
	undo() { wpa_cli -i $W remove_network $id >/dev/null; for o in $old; do wpa_cli -i $W enable_network $o >/dev/null; done; }
	# the name is in wpa_cli's escaped form from "scan" (æ/ø/å, emoji, " and \ as \xNN, \" and \\): P"..." makes
	# wpa_supplicant decode it - a plain "..." would look for a network literally named S\xc3\xb8ren
	wpa_cli -i $W set_network $id ssid "P\"$ssid\"" >/dev/null
	if [ -n "$psk" ]; then
		wpa_cli -i $W set_network $id psk "\"$psk\"" >/dev/null || { undo; echo "Invalid password"; exit 1; }
		wpa_cli -i $W set_network $id key_mgmt "WPA-PSK SAE" >/dev/null
		wpa_cli -i $W set_network $id ieee80211w 1 >/dev/null
	else
		wpa_cli -i $W set_network $id key_mgmt NONE >/dev/null
	fi
	wpa_cli -i $W select_network $id >/dev/null
	for i in $(seq 1 20); do
		st=$(wpa_cli -i $W status | grep '^wpa_state=' | cut -d= -f2)
		[ "$st" = COMPLETED ] && break
		sleep 1
	done
	if [ "$st" != COMPLETED ]; then
		undo # back to the network that worked
		msg "Could not connect to %s (wrong password?)" "$ssid"; exit 1
	fi
	for o in $old; do wpa_cli -i $W remove_network $o >/dev/null; done
	wpa_cli -i $W save_config >/dev/null
	nopower
	kill -USR1 $(cat /run/udhcpc.$W.pid 2>/dev/null) 2>/dev/null || \
		udhcpc -b -A 3 -i $W -x hostname:$(hostname) -s $H/dhcp-script -p /run/udhcpc.$W.pid >/dev/null 2>&1
	for i in $(seq 1 15); do
		ip -4 addr show $W | grep -q inet && { msg "Connected to %s" "$ssid"; exit 0; }
		sleep 1
	done
	msg "Connected to %s, but got no IP address" "$ssid"
	;;
forget)
	[ -n "$W" ] && wpa_cli -i $W remove_network all >/dev/null 2>&1 && wpa_cli -i $W save_config >/dev/null 2>&1
	rm -f $CONFW
	echo "Wi-Fi forgotten"
	;;
esac
