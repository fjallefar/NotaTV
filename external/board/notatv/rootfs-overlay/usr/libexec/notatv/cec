#!/bin/sh
# HDMI-CEC: daemon | setup | status | tv-on | tv-off | wake | on-standby
. /usr/libexec/notatv/lib.sh

devs() { ls /dev/cec* 2>/dev/null; }

attach_pulse8() {
	# a Pulse-Eight USB-CEC adapter must be attached to the kernel's CEC framework via inputattach
	for t in /sys/class/tty/ttyACM*; do
		[ -e "$t" ] || continue
		n=${t##*/}
		v=$(cat $t/device/../idVendor 2>/dev/null)
		[ "$v" = 2548 ] || continue
		[ -f $RUN/pulse8-$n ] && kill -0 $(cat $RUN/pulse8-$n) 2>/dev/null && continue
		inputattach --pulse8-cec /dev/$n >/dev/null 2>&1 &
		echo $! > $RUN/pulse8-$n
		log "cec: Pulse-Eight på /dev/$n"
		sleep 2
	done
}

phys() { cec-ctl -d $1 2>/dev/null | sed -n 's/.*Physical Address[[:space:]]*:[[:space:]]*//p' | head -1; }

configure() { # dev
	cec-ctl -d $1 --playback --osd-name "$(device_name | cut -c1-14)" >/dev/null 2>&1
}

wake() {
	for d in $(devs); do
		[ "$(cfg_get cec_wake_tv 1)" = 1 ] && cec-ctl -d $d --to 0 --image-view-on >/dev/null 2>&1
		if [ "$(cfg_get cec_active_source 1)" = 1 ]; then
			pa=$(phys $d)
			[ -n "$pa" ] && [ "$pa" != "f.f.f.f" ] && cec-ctl -d $d --to 15 --active-source phys-addr=$pa >/dev/null 2>&1
		fi
	done
}

# the TV turned off (cecd calls this when the TV sends Standby)
on_standby() {
	if [ "$(cfg_get cec_standby 1)" = 1 ] && [ ! -f $RUN/sleeping ]; then
		log "cec: TV slukket -> dvale"
		CEC_NO_TV_OFF=1 $H/power sleep &
	fi
}

case "$1" in
daemon)
	first=1
	while :; do
		attach_pulse8
		for d in $(devs); do
			n=${d##*/}
			# cecd answers the TV (Menu Request, power status, active source, standby); started again if it stops
			[ -f $RUN/cec-$n ] && kill -0 $(cat $RUN/cec-$n) 2>/dev/null && continue
			configure $d
			$H/cecd $d &
			echo $! > $RUN/cec-$n
			log "cec: $d konfigureret"
			# a start nobody asked for (the box stopped by itself, see bootcheck): leave the TV off
			if [ $first = 1 ]; then
				if [ -f $RUN/boot-unrequested ]; then log "cec: the box started by itself - the TV is left off"
				else wake; fi
			fi
		done
		first=0
		sleep 3
	done
	;;
setup)
	for d in $(devs); do configure $d; done
	;;
wake) wake ;;
on-standby) on_standby ;;
tv-on)
	[ -z "$(devs)" ] && { echo "No CEC adapter found"; exit 1; }
	for d in $(devs); do cec-ctl -d $d --to 0 --image-view-on >/dev/null 2>&1; done
	wake
	echo "Power-on command sent to the TV"
	;;
tv-off)
	[ -z "$(devs)" ] && { echo "No CEC adapter found"; exit 1; }
	for d in $(devs); do cec-ctl -d $d --to 0 --standby >/dev/null 2>&1; done
	echo "Power-off command sent to the TV"
	;;
status)
	[ -z "$(devs)" ] && { echo "No CEC adapter found"; exit 0; }
	# check every adapter: the TV can be on any of them (cec0 and cec1 are separate ports)
	tv="" pa=""
	for d in $(devs); do
		p=$(phys $d)
		[ -z "$p" ] || [ "$p" = "f.f.f.f" ] && continue
		[ -z "$pa" ] && pa=$p
		[ -n "$tv" ] && continue
		# the name comes with or without quotes depending on the cec-ctl version
		# ('\{0,1\}' works in both busybox and GNU sed; \? is not supported by BSD sed)
		tv=$(cec-ctl -d $d --to 0 --give-osd-name 2>/dev/null | sed -n "s/.*name:[[:space:]]*'\{0,1\}\([^']*\)'\{0,1\}.*/\1/p" | head -1)
	done
	[ -z "$pa" ] && { echo "Adapter found - no TV responds"; exit 0; }
	if [ -n "$tv" ]; then msg "Connected to %s (address %s)" "$tv" "$pa"; else msg "Connected (address %s)" "$pa"; fi
	;;
esac
