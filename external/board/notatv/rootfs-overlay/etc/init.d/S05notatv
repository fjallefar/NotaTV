#!/bin/sh
# NotaTV: quick basic setup before the user interface starts
. /usr/libexec/notatv/lib.sh

case "$1" in
start)
	# root never follows a symlink or opens a file that another user put in /tmp (systemd turns these on; NotaTV
	# has no systemd). Matters as soon as mpv/yt-dlp/UxPlay run as the user "media" (media_user)
	for k in protected_symlinks protected_hardlinks protected_fifos protected_regular; do
		echo 1 > /proc/sys/fs/$k 2>/dev/null || log "sysctl: fs.$k could not be set"
	done
	# no access times on the SD card (fewer writes); in S05 because the updater keeps cmdline.txt as it is
	mount -o remount,noatime / 2>/dev/null
	mkdir -p $RUN /tmp/notatv-inbox /media /data
	chmod 700 /tmp/notatv-inbox
	: > $RUN/mpv-local.conf
	# persistent data partition (created by the installer)
	dev=$(data_dev)
	# after a power cut: repair what the journal cannot (-p only fixes what is safe; a clean partition takes ms)
	[ -n "$dev" ] && command -v e2fsck >/dev/null && { e2fsck -p "$dev" >/dev/null 2>&1; [ $? -ge 4 ] && log "data: e2fsck found errors it could not fix on $dev"; }
	if [ -n "$dev" ] && mount -o noatime "$dev" /data 2>/dev/null; then
		echo installed > $RUN/mode
	else
		mount -t tmpfs -o size=64m tmpfs /data
		echo live > $RUN/mode
	fi
	mkdir -p /data/notatv
	# no clock of its own: start from the last known time instead of 1970 (see clock)
	$H/clock restore
	# why did the box start - asked for, or by itself (crash, freeze, no power)? (reads the saved time, not the clock)
	$H/bootcheck
	# Wi-Fi right away (in the background), so it is connected by the time the user interface is up
	$H/wifi boot >/dev/null 2>&1 &
	# targets for symlinks from the rootfs (see post-build.sh): Bluetooth, bluealsa, shader cache, mpv
	mkdir -p /data/notatv/bluetooth /data/notatv/bluealsa /data/notatv/cache /data/notatv/config
	# YouTube logins sent from the phone that were never approved: the question on the TV is gone after a restart
	rm -rf /data/notatv/youtube/pending
	# tokens, passwords and cookies (Plex, IPTV, Seerr, YouTube) for root only
	chmod -R go= /data/notatv
	# others may pass through (not list) the data folder: the user "media" (mediarun) reaches its own home in it, and
	# the programs from the App Store in tools/ (yt-dlp) - everything else in it stays root's only
	chmod 711 /data/notatv
	[ -d /data/notatv/tools ] && chmod -R go=rX /data/notatv/tools
	# audio default (HDMI with a connected TV) - runs in the background
	$H/audio setup >/dev/null 2>&1 &
	;;
stop)
	$H/clock save
	$H/logkeep # the last lines to the SD card
	mark_clean "restart or power off"
	sync
	umount /data 2>/dev/null
	;;
esac
exit 0
