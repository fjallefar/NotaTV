#!/bin/sh
# NotaTV: background services (do not block booting)
. /usr/libexec/notatv/lib.sh

case "$1" in
start)
	(
		# only the local network may reach the box's services (dhcp-script and net watch update it with the addresses)
		$H/firewall apply
		$H/net up
		$H/cec daemon &
		# phone remote / text input: httpd and its CGI as the user phone, the requests handled by phone-agent (root)
		# (A1 step 3, audit 9/11); the agent makes /run/notatv-phone first
		$H/phone-agent >/dev/null 2>&1 &
		usleep 300000
		httpd -p 80 -u phone:phone -h /usr/share/notatv/www
		[ "$(cfg_get ssh_enabled 0)" = 1 ] && $H/ssh on
		$H/music start
		$H/automount
		# clock: the Pi has no clock of its own. S05notatv starts it from the last known time (clock restore), so
		# HTTPS works at once; here the real time is fetched. Keep trying until a time server answers - the network
		# can come up late (the link can go down and up while booting) - then sync again every 6 hours.
		(
			n=0
			until timeout 30 ntpd -n -q -p pool.ntp.org; do
				n=$((n + 1))
				if [ $n -lt 30 ]; then sleep 10; else sleep 60; fi
			done
			$H/clock save
			# only with a hardware clock (e.g. an RTC add-on board; the Pi 4 has none). -u: the clock is in UTC, no /etc/adjtime
			[ -e /dev/rtc0 ] && hwclock -w -u
			while sleep 21600; do timeout 30 ntpd -n -q -p pool.ntp.org && $H/clock save; done
		) &
		# remember the time every 15 minutes, so a power cut loses at most 15 minutes (one small file on /data)
		# and the log's new lines to the SD card (logkeep: a few KB a day), so a box that stops by itself leaves a trace
		while sleep 900; do $H/clock save; $H/logkeep; done &
	) >/dev/null 2>&1 &
	;;
stop)
	$H/music stop
	[ -f $RUN/netwatch.pid ] && kill $(cat $RUN/netwatch.pid) 2>/dev/null
	killall -q phone-agent inotifyd httpd dropbear udhcpc wpa_cli wpa_supplicant 2>/dev/null
	;;
esac
exit 0
