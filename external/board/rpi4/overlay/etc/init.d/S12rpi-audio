#!/bin/sh
# NotaTV Pi: vc4 (display and HDMI audio) are modules and only exist after udev (S10)
#  - tell mpv which DRM card has display outputs (the v3d card has none)
#  - choose the audio output
[ "$1" = start ] || exit 0
mkdir -p /run/notatv
: > /run/notatv/mpv-drm.conf
(
	i=0
	while [ $i -lt 50 ]; do
		for c in /sys/class/drm/card[0-9]-HDMI-A-1; do
			[ -e "$c" ] || continue
			n=${c#/sys/class/drm/card}; n=${n%%-*}
			echo "drm-device=/dev/dri/card$n" > /run/notatv/mpv-drm.conf
			break 2
		done
		sleep 0.1; i=$((i+1))
	done
	i=0
	while [ ! -e /proc/asound/card0 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
	/usr/libexec/notatv/audio setup
) >/dev/null 2>&1 &
exit 0
