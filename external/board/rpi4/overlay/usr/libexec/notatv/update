#!/bin/sh
# Updating NotaTV on Raspberry Pi from GitHub releases.
#   check     "NY <version>" | "NYESTE <version>" | error text; the release (JSON) is saved in /tmp/notatv-update-release.json
#   install   download, verify and install crash-safe; prints "OK" (reboot afterwards)
#   rollback  put back the files the last update replaced; prints "OK" (reboot afterwards)
#             (also run automatically by session if the user interface keeps crashing right after an update)
#   resume    at boot (S05notatv-update): finish an install that was cut off after the commit point,
#             throw away one that was cut off before it, remove leftovers from older updaters
# Repo: cfg update_repo or /etc/notatv-update-repo ("owner/name"). The release must have the files
# notatv-rpi4-update.tar.gz and notatv-rpi4-update.tar.gz.sha256 (created by make rpi4).
#
# Safety rules:
# - /data (settings, logins, media) is never touched, except our own folders update/ and update-backup/
# - nothing on the system changes before the whole package is downloaded and checked (SHA256, paths,
#   version, CPU type, file type conflicts, free space) and every changed file is staged on the same
#   filesystem as its target. The switch is then one rename per file, recorded in a journal: after a power
#   cut the box ends up either on the old version or (at the next boot) on the new one, never in between.
# - only files that differ are written; config.txt, cmdline.txt and tryboot.txt on the boot partition are kept
# - a file missing from the new version is only removed if the installed file list
#   (/usr/share/notatv/files.list) says NotaTV put it there
# - writes never go through a symlink that leads out of the root filesystem (e.g. /root/.config -> /data)
# - the boot partition is the first partition of the disk the root filesystem is on (never another disk)
# - the kernel set (Image, *.dtb, overlays/) is never changed file by file: there are two sets, one in the root
#   of the boot partition and one in nota-b/, and the firmware uses the one notatv-slot.txt names (os_prefix,
#   included from config.txt). An update fills the set that is not in use and then switches with one write of
#   that small file (same size, one sector). A power cut leaves either the old or the new set complete, and
#   "Undo last update" switches back. Firmware files (start4.elf, fixup4.dat) are replaced as before.
. /usr/libexec/notatv/lib.sh

ASSET=notatv-rpi4-update.tar.gz
DL=/data/notatv/update          # download + unpacked package
BK=/data/notatv/update-backup   # old versions of replaced files (one step of rollback)
ST=/.notatv-update              # journal + staged files on the root filesystem
BOOT=/run/notatv/boot
BST=.notatv-new                 # staged files on the boot partition ($BOOT/$BST)
LIST=/usr/share/notatv/files.list
VERIFY=/data/notatv/update-verify
STATE=/tmp/notatv-update-state  # progress for the user interface: "<percent>" or "dl <bytes total> <file>"
KEEP_BOOT='config.txt cmdline.txt tryboot.txt notatv-slot.txt'
SLOTF=notatv-slot.txt           # on the boot partition: which kernel set the firmware loads
SLOTB=nota-b/                   # the second kernel set (the first is in the root)

die() { log "update: $*"; echo "$*"; exit 1; }
state() { echo "$*" > $STATE; }
# size in bytes of a release file, from the release JSON in $J (0 if unknown)
asset_size() {
	echo "$J" | tr ',{}' '\n\n\n' | awk -v n="\"$1\"" '
		/"name": *"/ { s = $0; sub(/.*"name": */, "", s); sub(/[ \t\r]+$/, "", s); if (s == n) hit = 1 }
		hit && /"size": *[0-9]/ { s = $0; sub(/.*"size": */, "", s); print s + 0; exit }'
}

# ---------------------------------------------------------------- helpers
repo() {
	r=$(cfg_get update_repo "")
	[ -n "$r" ] || r=$(cat /etc/notatv-update-repo 2>/dev/null)
	r=$(echo "$r" | tr -d ' \n')
	case "$r" in */*/*|*[!A-Za-z0-9._/-]*|/*|*/) echo "" ;; *) echo "$r" ;; esac
}
current() { sed -n 's/^VERSION=\([^ ]*\).*/\1/p' /etc/notatv-release; }
valid_ver() { echo "$1" | grep -Eq '^[0-9]+(\.[0-9]+){0,3}$'; }
# newer A B: true if version A > version B (numeric per part, 1.0.10 > 1.0.9)
newer() {
	awk -v a="$1" -v b="$2" 'BEGIN { n = split(a, x, "."); m = split(b, y, "."); if (m > n) n = m
		for (i = 1; i <= n; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 } exit 1 }'
}
# dir_of path: the folder of a relative path ("Image" -> ".", "overlays/x.dtbo" -> "overlays").
# Not "${f%/*}": for a name without "/" that gives the name itself, so "mkdir -p" made a FOLDER named after the
# file (1.0.0/1.0.1: the kernel was staged as .notatv-new/Image/Image and the update could never finish)
dir_of() { case "$1" in */*) echo "${1%/*}" ;; *) echo . ;; esac; }
# a file the old updater (1.0.0/1.0.1) put one folder too deep (X/X): the real file
legacy() { if [ -d "$1" ] && [ ! -L "$1" ] && [ -f "$1/${1##*/}" ]; then echo "$1/${1##*/}"; else echo "$1"; fi; }
# undo that in a whole tree (staging, backup): X/X -> X
unnest() {
	[ -d "$1" ] || return 0
	find "$1" -mindepth 1 -type d | sort -r | while IFS= read -r d; do
		n=${d##*/}
		[ -f "$d/$n" ] && [ "$(ls -A "$d" | wc -l)" = 1 ] || continue
		mv "$d/$n" "$d.unnest" && rmdir "$d" && mv "$d.unnest" "$d"
	done
}

free_kb() { df -Pk "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'; }
size_kb() { du -sk "$1" 2>/dev/null | awk '{ print $1 }'; }

latest() { # -> TAG (vX.Y.Z), VER (X.Y.Z)
	R=$(repo)
	[ -n "$R" ] || die "No GitHub repository set up yet"
	J=$(curl -fsSL -m 20 --retry 2 -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$R/releases/latest") \
		|| die "Could not reach GitHub"
	TAG=$(echo "$J" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
	[ -n "$TAG" ] || die "No releases found"
	VER=${TAG#v}
	valid_ver "$VER" || die "No releases found"
}

lock() {
	mkdir -p /run/notatv
	exec 9> /run/notatv/update.lock
	flock -n 9 || die "An update is already running"
}

# the boot partition: partition 1 on the same disk as / (with the label NOTABOOT)
boot_dev() {
	mm=$(mountpoint -d / 2>/dev/null) || return 1
	p=$(readlink -f "/sys/dev/block/$mm") || return 1
	[ -e "$p/partition" ] || return 1
	for q in "${p%/*}"/*/partition; do
		[ "$(cat "$q" 2>/dev/null)" = 1 ] || continue
		d=/dev/$(basename "${q%/partition}")
		blkid "$d" 2>/dev/null | grep -q 'LABEL="NOTABOOT"' || return 1
		echo "$d"; return 0
	done
	return 1
}
BOOT_MOUNTED=
mount_boot() {
	d=$(boot_dev) || return 1
	want=$(cat "/sys/class/block/${d##*/}/dev")
	if mountpoint -q $BOOT; then
		[ "$(mountpoint -d $BOOT)" = "$want" ] || return 1 # something else is mounted there
		return 0
	fi
	mkdir -p $BOOT && mount -t vfat "$d" $BOOT && BOOT_MOUNTED=1
}
umount_boot() { [ -n "$BOOT_MOUNTED" ] && { sync; umount $BOOT 2>/dev/null; BOOT_MOUNTED=; }; return 0; }

# safe_target path (relative to /): may a file be written at /path?
# The nearest existing parent must be a real directory on the root filesystem (not reached through a
# symlink to /data, /tmp etc.), and /path itself must not be a real directory.
safe_target() {
	t="/$1"
	case "$1" in ''|/*|../*|*/../*|*/..|..) return 1 ;; esac
	[ -d "$t" ] && [ ! -L "$t" ] && return 1
	p=${t%/*}; [ -n "$p" ] || p=/
	while [ ! -e "$p" ] && [ ! -L "$p" ]; do p=${p%/*}; [ -n "$p" ] || p=/; done
	[ -d "$p" ] || return 1
	r=$(readlink -f "$p") || return 1
	case "$r" in
	/data|/data/*|/tmp|/tmp/*|/run|/run/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/media|/media/*|/mnt|/mnt/*|"$ST"|"$ST"/*) return 1 ;;
	esac
	return 0
}

# put staged file $1 at $2 with one rename; a symlink at $2 is replaced, never followed
place() {
	d=${2%/*}; [ -n "$d" ] || d=/
	mkdir -p "$d" || return 1
	[ -L "$2" ] && { rm -f "$2" || return 1; }
	mv -f "$1" "$2"
}

# ---------------------------------------------------------------- kernel sets
kset() { case "$1" in Image|*.dtb|overlays/*) return 0 ;; esac; return 1; } # part of the kernel set?
# the set in use: "" (root) or "nota-b/" - only when config.txt really includes the slot file
active_slot() {
	grep -q "^include $SLOTF" "$BOOT/config.txt" 2>/dev/null || { echo ""; return; }
	sed -n 's/^os_prefix=\(.*\)$/\1/p' "$BOOT/$SLOTF" 2>/dev/null | head -1
}
other_slot() { [ "$1" = "$SLOTB" ] && echo "" || echo "$SLOTB"; }
# the slot file, always 128 bytes: rewritten in place it is one sector on the card
slot_text() {
	{ if [ -n "$1" ]; then printf 'os_prefix=%s\n' "$1"; else printf '# kernel set: the root of the boot partition\n'; fi
	  printf '# written by the NotaTV updater - do not edit\n'; } | awk '{ s = s $0 "\n" } END { printf "%s", s; for (i = length(s); i < 127; i++) printf "#"; printf "\n" }'
}
set_slot() {
	f="$BOOT/$SLOTF"
	if [ -f "$f" ] && [ "$(wc -c < "$f")" = 128 ]; then
		slot_text "$1" | dd of="$f" bs=128 count=1 conv=notrunc 2>/dev/null || return 1
	else
		slot_text "$1" > "$f.new" && mv -f "$f.new" "$f" || return 1
	fi
	sync
}
# a box from before the kernel sets: the slot file (root set) first, then config.txt includes it - both boot the
# same way, whichever state a power cut leaves
slot_migrate() {
	grep -q "^include $SLOTF" "$BOOT/config.txt" 2>/dev/null && return 0
	[ -f "$BOOT/$SLOTF" ] || set_slot "" || return 1
	{ cat "$BOOT/config.txt"; printf '\n[all]\n# the kernel set in use (the NotaTV updater switches it)\ninclude %s\n' "$SLOTF"; } > "$BOOT/config.txt.new" &&
		sync && mv -f "$BOOT/config.txt.new" "$BOOT/config.txt" && sync || return 1
	# an overclock test waiting for its tryboot (libexec/notatv/oc) must load the same set
	if [ -f "$BOOT/tryboot.txt" ] && ! grep -q "^include $SLOTF" "$BOOT/tryboot.txt"; then
		{ cat "$BOOT/tryboot.txt"; printf '\n[all]\ninclude %s\n' "$SLOTF"; } > "$BOOT/tryboot.txt.new" &&
			mv -f "$BOOT/tryboot.txt.new" "$BOOT/tryboot.txt"
	fi
	sync
}
# remove the kernel set at prefix $1 (never the one in use)
kset_clear() {
	if [ -n "$1" ]; then rm -rf "$BOOT/$1"
	else rm -rf "$BOOT/Image" "$BOOT/overlays"; rm -f "$BOOT"/*.dtb; fi
}

# ---------------------------------------------------------------- journal
# $ST/root.list   files to put in place, staged in $ST/new/<path>
# $ST/boot.list   firmware files to put on the boot partition, staged in $BOOT/$BST/<path>
# $ST/slot        the kernel set to switch to ("" or nota-b/, already complete on the boot partition)
# $ST/remove.list files to delete
# $ST/boot-remove.list files to delete on the boot partition (rollback of files an update added)
# $ST/version     the version being installed (for the log)
# $ST/COMMIT      written (after sync) when everything is staged; from then on the change is finished,
#                 also after a power cut. Without COMMIT the staging is thrown away.

discard() { # throw away an unfinished staging (nothing on the system was changed yet)
	rm -rf "$ST"
	if [ -n "$1" ] || mount_boot; then rm -rf "$BOOT/$BST"; umount_boot; fi
	sync
}

apply() { # finish a committed change; can be run again any number of times
	if [ -s "$ST/boot.list" ] || [ -s "$ST/boot-remove.list" ] || [ -f "$ST/slot" ]; then mount_boot || return 1; fi
	# the kernel set first: one small write
	if [ -f "$ST/slot" ]; then
		want=$(cat "$ST/slot")
		[ "$(active_slot)" = "$want" ] || set_slot "$want" || return 1
	fi
	while IFS= read -r f; do
		[ -e "$ST/new/$f" ] || [ -L "$ST/new/$f" ] || continue # already in place
		place "$ST/new/$f" "/$f" || return 1
	done < "$ST/root.list"
	if [ -s "$ST/boot.list" ]; then
		while IFS= read -r f; do
			[ -e "$BOOT/$BST/$f" ] || continue
			src=$(legacy "$BOOT/$BST/$f") # staged by 1.0.0/1.0.1 as X/X
			mkdir -p "$BOOT/$(dir_of "$f")" && mv -f "$src" "$BOOT/$f" || return 1
		done < "$ST/boot.list"
	fi
	[ -s "$ST/boot-remove.list" ] && while IFS= read -r f; do
		case "$f" in ''|/*|*..*) continue ;; esac
		case " $KEEP_BOOT " in *" $f "*) continue ;; esac
		rm -f "$BOOT/$f"
	done < "$ST/boot-remove.list"
	[ -f "$ST/remove.list" ] && while IFS= read -r f; do
		{ [ -L "/$f" ] || [ -f "/$f" ]; } && rm -f "/$f"
	done < "$ST/remove.list"
	sync
	rm -rf "$BOOT/$BST"; umount_boot
	log "update: $(cat "$ST/version" 2>/dev/null) is in place$([ -f "$ST/slot" ] && echo " (kernel set: /$(cat "$ST/slot"))")"
	rm -rf "$ST"; sync
}

# stage SRC: stage the files listed in $ST/root.list from SRC/rootfs and $ST/boot.list from SRC/boot
stage() {
	while IFS= read -r f; do
		mkdir -p "$ST/new/$(dir_of "$f")" && cp -a "$1/rootfs/$f" "$ST/new/$f" || return 1
	done < "$ST/root.list"
	if [ -s "$ST/boot.list" ]; then
		while IFS= read -r f; do
			mkdir -p "$BOOT/$BST/$(dir_of "$f")" && cp "$1/boot/$f" "$BOOT/$BST/$f" || return 1
		done < "$ST/boot.list"
	fi
	sync
}

commit() {
	sync
	echo "$1" > "$ST/version" && sync && : > "$ST/COMMIT" && sync
}

data_mounted() { awk '$2 == "/data" && $3 != "tmpfs" { f = 1 } END { exit !f }' /proc/mounts; }
data_ok() { # /data must be the real data partition (not the tmpfs fallback), and / must be writable
	data_mounted || die "The data partition is not mounted"
	touch /.notatv-rw 2>/dev/null && rm -f /.notatv-rw || die "The system partition is read-only"
}

# ---------------------------------------------------------------- install
install() {
	latest
	CUR=$(current)
	newer "$VER" "$CUR" || die "You already have the latest version"
	data_ok
	[ -e "$ST/COMMIT" ] && { apply || die "Restart the box to finish the previous update"; }
	discard
	[ "$(free_kb /data)" -gt 800000 ] 2>/dev/null || die "Not enough free space for the update"

	# download (a cut-off download of the same version continues where it stopped)
	[ "$(cat $DL/tag 2>/dev/null)" = "$TAG" ] || { rm -rf $DL; mkdir -p $DL; echo "$TAG" > $DL/tag; }
	rm -rf $DL/new
	U="https://github.com/$(repo)/releases/download/$TAG"
	state 0
	progress "$(msg "Downloading NotaTV %s…" "$VER")"
	curl -fsSL -m 30 --retry 3 -o $DL/$ASSET.sha256 "$U/$ASSET.sha256" || die "Download failed"
	state dl "$(asset_size $ASSET)" $DL/$ASSET
	curl -fsSL --retry 5 --retry-delay 5 --speed-limit 2000 --speed-time 60 -C - -o $DL/$ASSET "$U/$ASSET" ||
		curl -fsSL --retry 3 --retry-delay 5 --speed-limit 2000 --speed-time 60 -o $DL/$ASSET "$U/$ASSET" ||
		die "Download failed"

	# check
	want=$(awk 'NR == 1 { print $1 }' $DL/$ASSET.sha256)
	echo "$want" | grep -Eq '^[0-9a-f]{64}$' || die "Download failed"
	if [ "$(sha256sum $DL/$ASSET | awk '{ print $1 }')" != "$want" ]; then
		rm -rf $DL; die "The file is damaged (SHA256 does not match)"
	fi
	state 86
	progress "Checking files…"
	gunzip -c $DL/$ASSET 2>/dev/null | tar -tv -f - > $DL/names.v 2>/dev/null || { rm -rf $DL; die "Could not unpack"; }
	awk '{ print $6 }' $DL/names.v > $DL/names
	# only boot/ and rootfs/, no absolute paths or "..", nothing for /data, /dev, /tmp etc.
	if grep -vE '^(\./|boot/|rootfs/)' $DL/names | grep -q . ||
		grep -Eq '(^|/)\.\.(/|$)' $DL/names ||
		grep -Eq '^rootfs/(data|dev|proc|sys|tmp|run|media|mnt)(/|$)' $DL/names ||
		grep -Eq '^rootfs/\.notatv-update(/|$)' $DL/names ||
		grep -q ' ' $DL/names ||
		! awk 'NR == FNR { if ($1 ~ /^l/) { n = $6; sub("/$", "", n); l[n] = 1 } next }
			{ n = $6; while (sub("/[^/]*$", "", n)) if (n in l) exit 1 }' $DL/names.v $DL/names.v; then
		# (the last test: nothing may be unpacked through a symlink in the package itself)
		rm -rf $DL; die "The update does not fit this device"
	fi
	sz=$(size_kb $DL/$ASSET)
	[ "$(free_kb /data)" -gt $((sz * 3)) ] 2>/dev/null || die "Not enough free space for the update"
	state 90
	progress "Unpacking…"
	mkdir -p $DL/new && gunzip -c $DL/$ASSET 2>/dev/null | tar -x -f - -C $DL/new 2>$DL/tar.err ||
		{ log "update: $(tail -3 $DL/tar.err)"; rm -rf $DL/new; die "Could not unpack"; }
	N=$DL/new
	for f in usr/bin/tvshell bin/busybox usr/libexec/notatv/update etc/notatv-release etc/init.d/rcS; do
		[ -f "$N/rootfs/$f" ] || { rm -rf $N; die "The update is missing files"; }
	done
	for f in Image bcm2711-rpi-4-b.dtb start4.elf fixup4.dat; do
		[ -s "$N/boot/$f" ] || { rm -rf $N; die "The update is missing files"; }
	done
	# the right device and the version the release says
	[ "$(sed -n 's/^VERSION=\([^ ]*\).*/\1/p' $N/rootfs/etc/notatv-release)" = "$VER" ] || { rm -rf $N; die "The update does not fit this device"; }
	[ "$(od -An -tx1 -j18 -N2 $N/rootfs/usr/bin/tvshell | tr -d ' \n')" = b700 ] || { rm -rf $N; die "The update does not fit this device"; }
	[ "$(od -An -tx1 -j18 -N2 $N/rootfs/bin/busybox | tr -d ' \n')" = b700 ] || { rm -rf $N; die "The update does not fit this device"; }

	# what changes (only files that differ)
	state 94
	progress "Preparing…"
	mount_boot || die "The boot partition was not found"
	mkdir -p "$ST" || die "The system partition is read-only"
	: > "$ST/root.list"; : > "$ST/boot.list"; : > "$ST/remove.list"
	(cd $N/rootfs && find . ! -type d) | sed 's,^\./,,' > $DL/new.list
	need=0
	while IFS= read -r f; do
		n="$N/rootfs/$f"; t="/$f"
		if [ -L "$n" ]; then
			[ -L "$t" ] && [ "$(readlink "$n")" = "$(readlink "$t")" ] && continue
		elif [ -f "$n" ]; then
			if [ -f "$t" ] && [ ! -L "$t" ] && cmp -s "$n" "$t"; then
				[ "$(ls -ln "$n" | awk '{ print $1, $3, $4 }')" = "$(ls -ln "$t" | awk '{ print $1, $3, $4 }')" ] && continue
			fi
			need=$((need + $(size_kb "$n") + 4))
		else
			continue # device nodes/fifos are never in the package; skip them if they are
		fi
		safe_target "$f" || { discard 1; log "update: conflict at /$f"; die "The update does not fit this device"; }
		echo "$f" >> "$ST/root.list"
	done < $DL/new.list
	if [ -f $LIST ]; then
		grep -vxF -f $DL/new.list $LIST | while IFS= read -r f; do
			{ [ -L "/$f" ] || [ -f "/$f" ]; } && safe_target "$f" && echo "$f"
		done > "$ST/remove.list"
	fi
	bneed=0
	slot_migrate || { discard 1; die "The update could not be installed - nothing was changed"; }
	CURSLOT=$(active_slot); NEWSLOT=$(other_slot "$CURSLOT")
	(cd $N/boot && find . ! -type d) | sed 's,^\./,,' | while IFS= read -r f; do
		case " $KEEP_BOOT " in *" $f "*) continue ;; esac
		case "$f" in ''|/*|*..*) continue ;; esac
		kset "$f" && continue # the kernel set goes in as a whole (below)
		cmp -s "$N/boot/$f" "$BOOT/$f" || echo "$f"
	done > "$ST/boot.list"
	while IFS= read -r f; do bneed=$((bneed + $(size_kb "$N/boot/$f") + 4)); done < "$ST/boot.list"
	# a new kernel set only if something in it differs from the set in use
	(cd $N/boot && find . ! -type d) | sed 's,^\./,,' | while IFS= read -r f; do
		kset "$f" && ! cmp -s "$N/boot/$f" "$BOOT/$CURSLOT$f" && echo "$f"
	done > $DL/kset.diff
	kneed=0
	if [ -s $DL/kset.diff ]; then
		kneed=$(du -sk $N/boot | awk '{ print $1 }')
		kfree=$(( $(free_kb $BOOT) + $(cd "$BOOT" && du -sk ${NEWSLOT:-Image overlays} ${NEWSLOT:+} 2>/dev/null | awk '{ s += $1 } END { print s + 0 }') ))
		[ -z "$NEWSLOT" ] && kfree=$((kfree + $(du -sk "$BOOT"/*.dtb 2>/dev/null | awk '{ s += $1 } END { print s + 0 }')))
		[ "$kfree" -gt $((kneed + bneed + 1024)) ] 2>/dev/null || { discard 1; die "Not enough free space for the update"; }
	fi
	[ "$(free_kb /)" -gt $((need + 20000)) ] 2>/dev/null || { discard 1; die "Not enough free space for the update"; }
	[ "$(free_kb $BOOT)" -gt $((bneed + 1024)) ] 2>/dev/null || [ -s $DL/kset.diff ] || { discard 1; die "Not enough free space for the update"; }

	# backup of everything that will be replaced or removed (for rollback)
	state 97
	progress "Installing…"
	rm -rf $BK; mkdir -p $BK/root $BK/boot || { discard 1; die "The update could not be installed - nothing was changed"; }
	: > $BK/added.list; : > $BK/boot-added.list
	ok=1
	cat "$ST/root.list" "$ST/remove.list" | while IFS= read -r f; do
		if [ -e "/$f" ] || [ -L "/$f" ]; then
			mkdir -p "$BK/root/$(dir_of "$f")" && cp -a "/$f" "$BK/root/$f" || exit 1
		else echo "$f" >> $BK/added.list; fi
	done || ok=
	while IFS= read -r f; do
		if [ -e "$BOOT/$f" ]; then mkdir -p "$BK/boot/$(dir_of "$f")" && cp "$BOOT/$f" "$BK/boot/$f" || { ok=; break; }
		else echo "$f" >> $BK/boot-added.list; fi
	done < "$ST/boot.list"
	echo "$CUR" > $BK/version
	printf '%s\n' "$CURSLOT" > $BK/slot # the old kernel set stays complete: "Undo" switches back to it
	[ -n "$ok" ] || { rm -rf $BK; discard 1; die "The update could not be installed - nothing was changed"; }

	# stage, commit, switch
	if [ -s $DL/kset.diff ]; then # the new kernel set, complete, in the set that is not in use
		kset_clear "$NEWSLOT"
		(cd $N/boot && find . ! -type d) | sed 's,^\./,,' | while IFS= read -r f; do
			kset "$f" || continue
			mkdir -p "$BOOT/$NEWSLOT$(dir_of "$f")" && cp "$N/boot/$f" "$BOOT/$NEWSLOT$f" || exit 1
		done || { rm -rf $BK; discard 1; die "The update could not be installed - nothing was changed"; }
		# the firmware reads cmdline.txt from the set too (os_prefix)
		[ -n "$NEWSLOT" ] && { cp "$BOOT/cmdline.txt" "$BOOT/${NEWSLOT}cmdline.txt" || { rm -rf $BK; discard 1; die "The update could not be installed - nothing was changed"; }; }
		sync
		printf '%s' "$NEWSLOT" > "$ST/slot"
	fi
	stage $N || { rm -rf $BK; discard 1; die "The update could not be installed - nothing was changed"; }
	sync
	commit "$VER" || { rm -rf $BK; discard 1; die "The update could not be installed - nothing was changed"; }
	apply || die "Restart the box to finish the update"
	rm -rf $DL; sync
	[ "$(current)" = "$VER" ] || die "The update could not be installed"
	echo 0 > $VERIFY; sync
	state 100
	log "update: $CUR -> $VER"
	echo OK
}

# ---------------------------------------------------------------- rollback
rollback() {
	data_ok
	[ -f $BK/version ] && [ -d $BK/root ] || die "No earlier version saved"
	unnest $BK/boot # a backup made by 1.0.0/1.0.1 has the kernel as Image/Image
	[ -e "$ST/COMMIT" ] && { apply || die "Restart the box to finish the previous update"; }
	discard
	mount_boot || die "The boot partition was not found"
	mkdir -p "$ST" || die "The system partition is read-only"
	(cd $BK/root && find . ! -type d) | sed 's,^\./,,' > "$ST/root.list"
	while IFS= read -r f; do safe_target "$f" || { discard 1; die "The update could not be installed - nothing was changed"; }; done < "$ST/root.list"
	while IFS= read -r f; do
		{ [ -L "/$f" ] || [ -f "/$f" ]; } && safe_target "$f" && echo "$f"
	done < $BK/added.list > "$ST/remove.list"
	# a backup from an updater without kernel sets has the kernel among its files: put back like the rest
	(cd $BK/boot && find . ! -type d) | sed 's,^\./,,' | while IFS= read -r f; do
		[ -f $BK/slot ] && kset "$f" && continue
		echo "$f"
	done > "$ST/boot.list"
	# the kernel set from before the update is still complete: switch back to it
	if [ -f $BK/slot ]; then
		old=$(cat $BK/slot)
		[ -s "$BOOT/${old}Image" ] && [ "$(active_slot)" != "$old" ] && printf '%s' "$old" > "$ST/slot"
	fi
	cp $BK/boot-added.list "$ST/boot-remove.list" 2>/dev/null
	mkdir -p $ST/src && ln -s $BK/root $ST/src/rootfs && ln -s $BK/boot $ST/src/boot || { discard 1; die "The update could not be installed - nothing was changed"; }
	stage $ST/src || { discard 1; die "The update could not be installed - nothing was changed"; }
	rm -rf $ST/src
	commit "$(cat $BK/version)" || { discard 1; die "The update could not be installed - nothing was changed"; }
	apply || die "Restart the box to finish the update"
	log "update: rolled back to $(cat $BK/version)"
	rm -rf $BK $VERIFY; sync
	echo OK
}

# ---------------------------------------------------------------- boot
resume() {
	if [ -e "$ST/COMMIT" ]; then
		printf "%s\n" "NotaTV: finishing the update" > /dev/console
		kernel=; { [ -s "$ST/boot.list" ] || [ -f "$ST/slot" ]; } && kernel=1
		if apply; then
			# the kernel/firmware changed: start once more, so the box runs the new one (not the old one with new files)
			[ -n "$kernel" ] && { log "update: boot files changed - restarting"; sync; reboot; sleep 30; }
		else
			log "update: could not finish the update at boot"
		fi
	elif [ -d "$ST" ]; then
		discard
	fi
	# leftovers from the first updater (1.0.0/1.0.1): it left "*.tvnew" symlinks inside folders that
	# symlinks point to, a full copy of the system as backup, and half-copied files after a power cut
	if [ -d $BK ] && [ ! -f $BK/version ]; then rm -rf $BK; fi
	# (searched once per box, not at every boot: a flag in /data says it is done)
	if ! [ -f /data/notatv/.tvnew-cleaned ]; then
		find / -xdev -name '*.tvnew' ! -type d -exec rm -f {} \; 2>/dev/null
		if data_mounted; then
			find /data/notatv -maxdepth 3 -name '*.tvnew' -type l -exec rm -f {} \; 2>/dev/null
			touch /data/notatv/.tvnew-cleaned
		fi
	fi
	return 0
}

case "$1" in
check)
	latest
	# the release (its text has the short "what is new" the update card shows, see CHANGELOG.md)
	printf '%s' "$J" > /tmp/notatv-update-release.json.tmp && mv /tmp/notatv-update-release.json.tmp /tmp/notatv-update-release.json
	if newer "$VER" "$(current)"; then echo "NY $VER"; else echo "NYESTE $(current)"; fi
	;;
install) lock; install ;;
rollback) lock; rollback ;;
resume) lock; resume ;;
*) exit 1 ;;
esac
